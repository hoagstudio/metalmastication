---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YouTube from '../components/YouTube.astro';
import logo from '../assets/logo.png';
import {
  episodes,
  seasons,
  latestEpisode,
  formatLength,
  formatDate,
  subscribeUrl,
} from '../data/episodes';

const latest = latestEpisode();
const allSeasons = seasons();
const currentSeason = allSeasons[0].season;
---

<Layout
  title="Metal Mastication | Can a Metalhead Cook?"
  description="Host Brett Hoag gets in the kitchen with heavy metal musicians to cook, eat, and hear stories of food and rock 'n' roll. Now in Season 2."
  current="home"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">Now in Season {currentSeason}</p>
        <h1>Can a Metalhead Cook?</h1>
        <p class="lead">
          Get in the kitchen with Metal Mastication and listen to stories of food and rock 'n' roll.
        </p>
        <p>
          Host Brett Hoag cooks with our favorite metal musicians. Some of them know how to cook, some not so
          much, and all of them have great stories to share. Being around food is a great way to get to those
          stories, and Brett gets them to tell stuff you've never heard from them before.
        </p>
        <div class="actions">
          <a class="btn" href="#latest">Watch the latest episode</a>
          <a class="btn btn-ghost" href={subscribeUrl} target="_blank" rel="noopener">Subscribe on YouTube</a>
        </div>
        <p class="stats">
          <span>{allSeasons.length} seasons</span>
          <span>{episodes.length} episodes</span>
        </p>
      </div>
      <div class="hero-art">
        <Image
          src={logo}
          alt="Metal Mastication logo: a skull biting a steel bar"
          width={512}
          height={512}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="latest" class="latest" aria-labelledby="latest-title">
    <div class="wrap">
      <p class="plate">What's cooking</p>
      <div class="latest-grid">
        <YouTube id={latest.youtubeId} title={latest.title} parts={latest.parts} />
        <div class="latest-copy">
          <p class="ep-meta">
            Season {latest.season} · Episode {latest.number} · {formatLength(latest.seconds)}
          </p>
          <h2 id="latest-title">{latest.title}</h2>
          <p class="guests">
            {latest.title !== latest.guests && <span>{latest.guests}</span>}
            {latest.band && <span class="band">{latest.band}</span>}
          </p>
          <p class="summary">{latest.summary}</p>
          {latest.description && <p>{latest.description}</p>}
        </div>
      </div>
    </div>
  </section>

  <section id="episodes" class="episodes" aria-labelledby="episodes-title">
    <div class="wrap">
      <h2 id="episodes-title" class="section-title">All episodes</h2>

      {
        allSeasons.map(({ season, episodes: list }) => (
          <div class="season">
            <h3 class="plate season-title">Season {season}</h3>
            <div class="ep-grid">
              {list.map((ep) => (
                <article class="ep-card" id={`s${ep.season}e${ep.number}`}>
                  <YouTube id={ep.youtubeId} title={ep.title} parts={ep.parts} />
                  <div class="ep-body">
                    <p class="ep-meta">
                      Episode {ep.number} · {formatLength(ep.seconds)} · {formatDate(ep.date)}
                    </p>
                    <h4>{ep.title}</h4>
                    <p class="guests">
                      {ep.title !== ep.guests && <span>{ep.guests}</span>}
                      {ep.band && <span class="band">{ep.band}</span>}
                    </p>
                    <p class="summary">{ep.summary}</p>
                    {ep.description && <p class="description">{ep.description}</p>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(55% 75% at 78% 45%, var(--glow), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(3.2rem, 8.5vw, 6.5rem);
  }

  .lead {
    max-width: 30ch;
    color: var(--text);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.45;
  }

  .hero-copy > p:not(.kicker, .lead, .stats) {
    max-width: 54ch;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stats span + span::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 1.1rem 0.15em 0;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }

  .hero-art :global(img) {
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 60px rgba(109, 40, 217, 0.45));
  }

  /* ---------- Latest episode ---------- */

  .latest {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .latest-grid :global(.player) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }

  .latest h2 {
    font-size: clamp(2.4rem, 5vw, 3.75rem);
  }

  .ep-meta {
    margin: 0 0 0.6rem;
    color: var(--accent-text);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guests {
    margin: 0 0 1rem;
    color: var(--text);
    font-weight: 600;
  }

  .guests .band {
    color: var(--muted);
    font-weight: 500;
  }

  .guests span + .band::before {
    content: ' · ';
    color: var(--muted);
  }

  .summary {
    color: var(--text);
  }

  /* ---------- All episodes ---------- */

  .episodes {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .section-title {
    margin-bottom: 2rem;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }

  .season + .season {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .season-title {
    font-size: 1.15rem;
  }

  .ep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .ep-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    scroll-margin-top: 5.5rem;
  }

  .ep-body {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .ep-card h4 {
    margin: 0 0 0.4rem;
    color: var(--text);
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ep-card .guests {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .ep-card .summary {
    margin-bottom: 0.6rem;
    font-size: 0.97rem;
  }

  .description {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
  }

  /* ---------- Small screens ---------- */

  @media (max-width: 860px) {
    .hero-grid,
    .latest-grid {
      grid-template-columns: 1fr;
    }

    .hero-art {
      order: -1;
    }

    .hero-art :global(img) {
      max-width: 240px;
    }
  }
</style>
